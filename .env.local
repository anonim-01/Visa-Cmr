# IATA Timatic API Configuration
IATA_API_KEY=your_iata_api_key_here
IATA_BASE_URL=https://api.iata.org/timatic/v3/autocheck

# Google Cloud Document AI
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-credentials.json
DOCUMENT_AI_LOCATION=eu

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Settings
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Security (Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long-for-development
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars-for-development

# External Services (Optional)
EMAIL_SERVICE_API_KEY=
SMS_SERVICE_API_KEY=

# Monitoring
LOG_LEVEL=info
SENTRY_DSN=
